    "fontSize": "19px",
    "primaryColor": "#FFFFFF",
    "primaryBorderColor": "#9AA5B1",
    "primaryTextColor": "#1F2933",
    "lineColor": "#6B7785",
    "secondaryColor": "#F2F5F7",
    "tertiaryColor": "#FFFFFF",
    "clusterBkg": "#FFFFFF",
    "clusterBorder": "#C9D1D9",
