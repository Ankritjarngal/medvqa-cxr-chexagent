__pycache__/
*.pyc
.pytest_cache/

# Generated baseline outputs (images, test sets, results) -- regenerate via
# `python -m baseline.run_baseline` or the Colab notebook, don't commit them.
data/*
!data/.gitkeep

# Source paper PDFs are not redistributed; see docs/papers/README.md
docs/papers/*.pdf

# Retrieval corpora (textbooks are copyrighted; never commit) and dataset caches
rag_cache/
raw_cache/

# LaTeX build files (main.pdf and main.tex are kept)
deliverables/report/*.aux
deliverables/report/*.log
deliverables/report/*.out
deliverables/report/*.toc
deliverables/report/*.lof
deliverables/report/*.fls
deliverables/report/*.fdb_latexmk
deliverables/report/*.synctex.gz
